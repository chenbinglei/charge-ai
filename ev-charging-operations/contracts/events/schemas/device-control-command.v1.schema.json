{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.evco.local/events/device-control-command.v1.schema.json",
  "title": "device.control-command.requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "aggregateType", "aggregateId", "partitionKey", "traceId", "idempotencyKey", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "device.control-command.requested.v1"},
    "schemaVersion": {"const": "1.0"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "aggregateType": {"const": "deviceConnector"},
    "aggregateId": {"type": "string", "minLength": 1},
    "partitionKey": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
    "traceId": {"type": "string", "minLength": 16, "maxLength": 64},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceCommandId", "deviceLifecycleId", "connectorId", "commandType", "commandSequence", "expectedStateVersion", "expiresAt", "authorizationSnapshotId", "requestedBy"],
      "properties": {
        "deviceCommandId": {"type": "string", "format": "uuid"},
        "deviceLifecycleId": {"type": "string", "format": "uuid"},
        "connectorId": {"type": "string", "minLength": 1},
        "commandType": {"enum": ["START_CHARGING", "STOP_CHARGING", "RESET", "ENABLE_CONNECTOR", "DISABLE_CONNECTOR"]},
        "commandSequence": {"type": "integer", "minimum": 1},
        "expectedStateVersion": {"type": "integer", "minimum": 0},
        "expiresAt": {"type": "string", "format": "date-time"},
        "authorizationSnapshotId": {"type": "string", "format": "uuid"},
        "requestedBy": {"type": "string", "minLength": 1},
        "reasonCode": {"type": "string", "maxLength": 64}
      }
    }
  }
}
