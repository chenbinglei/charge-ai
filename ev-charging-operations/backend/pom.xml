<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.elink.evco</groupId>
    <artifactId>evco-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>EV Charging Operations Backend</name>
    <description>W0 service-boundary skeleton; no business capability.</description>

    <modules>
        <module>libraries/shared-kernel</module>
        <module>libraries/contracts</module>
        <module>libraries/testkit</module>
        <module>services/api-gateway</module>
        <module>services/platform-service</module>
        <module>services/finance-service</module>
        <module>services/device-connectivity-service</module>
        <module>services/integration-service</module>
        <module>services/telemetry-service</module>
        <module>services/ecosystem-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-w0-service-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.elink.evco:evco-api-gateway</exclude>
                                        <exclude>com.elink.evco:evco-platform-service</exclude>
                                        <exclude>com.elink.evco:evco-finance-service</exclude>
                                        <exclude>com.elink.evco:evco-device-connectivity-service</exclude>
                                        <exclude>com.elink.evco:evco-integration-service</exclude>
                                        <exclude>com.elink.evco:evco-telemetry-service</exclude>
                                        <exclude>com.elink.evco:evco-ecosystem-service</exclude>
                                    </excludes>
                                    <message>服务之间不得建立 Maven 内部依赖；跨服务协作必须先经过契约与审批。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
