<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.elink.evco</groupId>
    <artifactId>evco-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>EV Charging Operations Backend</name>
    <description>W1 engineering foundation; no business capability.</description>

    <modules>
        <module>libraries/shared-kernel</module>
        <module>libraries/contracts</module>
        <module>libraries/testkit</module>
        <module>services/api-gateway</module>
        <module>services/platform-service</module>
        <module>services/finance-service</module>
        <module>services/device-connectivity-service</module>
        <module>services/integration-service</module>
        <module>services/telemetry-service</module>
        <module>services/ecosystem-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <spotless.version>2.44.3</spotless.version>
        <google-java-format.version>1.23.0</google-java-format.version>
        <jacoco.version>0.8.12</jacoco.version>
        <maven-checkstyle-plugin.version>3.4.0</maven-checkstyle-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <flyway-maven-plugin.version>11.3.2</flyway-maven-plugin.version>
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-w1-service-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.9,4.0.0)</version>
                                </requireMavenVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.elink.evco:evco-api-gateway</exclude>
                                        <exclude>com.elink.evco:evco-platform-service</exclude>
                                        <exclude>com.elink.evco:evco-finance-service</exclude>
                                        <exclude>com.elink.evco:evco-device-connectivity-service</exclude>
                                        <exclude>com.elink.evco:evco-integration-service</exclude>
                                        <exclude>com.elink.evco:evco-telemetry-service</exclude>
                                        <exclude>com.elink.evco:evco-ecosystem-service</exclude>
                                    </excludes>
                                    <message>服务之间不得建立 Maven 内部依赖；跨服务协作必须先经过契约与审批。</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                        </googleJavaFormat>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>check-java-format</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/ev-charging-operations/backend/config/checkstyle/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <failsOnError>true</failsOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>check-java-documentation</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-coverage-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>create-coverage-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>generate-backend-sbom</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <outputName>backend-sbom</outputName>
                            <includeTestScope>true</includeTestScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>flyway</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <version>${flyway-maven-plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <url>${env.EVCO_FLYWAY_URL}</url>
                            <user>${env.EVCO_FLYWAY_USER}</user>
                            <password>${env.EVCO_FLYWAY_PASSWORD}</password>
                            <schemas>
                                <schema>${env.EVCO_FLYWAY_SCHEMA}</schema>
                            </schemas>
                            <defaultSchema>${env.EVCO_FLYWAY_SCHEMA}</defaultSchema>
                            <locations>
                                <location>filesystem:${maven.multiModuleProjectDirectory}/ev-charging-operations/database/mysql/${env.EVCO_FLYWAY_SCHEMA}/migration</location>
                            </locations>
                            <createSchemas>true</createSchemas>
                            <cleanDisabled>true</cleanDisabled>
                            <validateMigrationNaming>true</validateMigrationNaming>
                            <validateOnMigrate>true</validateOnMigrate>
                            <outOfOrder>false</outOfOrder>
                            <encoding>UTF-8</encoding>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
